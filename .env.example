# Frontend environment variables (Vite).
# Every VITE_* value is bundled into the browser and is PUBLIC — never put
# real secrets here. Copy to `.env` (shared) and set mode-specific API URLs in
# `.env.development` / `.env.production`.

# Backend API base URL (mode-specific)
#   development -> http://localhost:4000
#   production  -> https://secure-study-hub-backend.vercel.app
VITE_API_URL="http://localhost:4000"

# Supabase project (URL + PUBLIC anon key — protected by Row Level Security)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# UPI id shown on the payment screen (public)
VITE_PAYMENT_UPI_ID="your-upi-id@bank"
